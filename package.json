{
  "name": "screener-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-venue crypto screener with Vela charts and Pine scans",
  "author": "Screener",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "sidecar": "tsx sidecar/server.ts",
    "sidecar:build": "node electron/build-sidecar.mjs",
    "electron:assets": "npm run build && npm run sidecar:build",
    "electron:start": "npm run electron:assets && electron .",
    "electron:pack": "npm run electron:assets && electron-builder --win dir",
    "library:catalog": "node scripts/build-library-catalog.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@assistant-ui/react": "^0.15.32",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@luxalgo/vela": "^0.10.1",
    "@uiw/react-codemirror": "^4.25.12",
    "ai": "^7.0.162",
    "bitget-api": "^3.2.7",
    "bybit-api": "^4.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "okx-api": "^3.2.8",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-shimmer": "^0.4.14",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.screener.v2",
    "productName": "Screener",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/window-state.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-electron/sidecar.cjs",
        "to": "sidecar.cjs"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    }
  }
}
