{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@luxalgo/vela": ["../Vela/src/index.ts"],
      "@luxalgo/vela/workspace": ["../Vela/src/workspace/index.ts"],
      "@luxalgo/vela/plugin": ["../Vela/src/plugin.ts"],
      "@luxalgo/vela/ui": ["../Vela/src/ui/index.ts"],
      "@luxalgo/vela/providers/binance": ["../Vela/src/data/providers/binance/index.ts"],
      "@screener/pine-engine": ["../pine-engine/src/index.ts"],
      "@screener/pine-editor": ["../pine-editor/src/index.ts"]
    },
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "sidecar", "test", "vite.config.ts", "vitest.config.ts"]
}
